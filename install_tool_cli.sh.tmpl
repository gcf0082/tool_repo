#!/bin/sh
# tool_cli bootstrap installer
#
# Usage:
#   curl -fsSL {{.BaseURL}}/install_tool_cli | sh
#
# Environment:
#   DEST  install path (default: /usr/local/bin/tool_cli).
#         Set to a user-writable path to avoid sudo, e.g.
#           ... | DEST=$HOME/.local/bin/tool_cli sh
#
# This script downloads the tool_cli binary from the server's bundled
# binary endpoint (GET /tool_cli?os=X&arch=Y), installs to $DEST, and
# runs 'tool_cli set-url {{.BaseURL}}'. No extraction, no packages
# deployment required — the binary is baked into the tool_repo server.
set -eu

DEST="${DEST:-/usr/local/bin/tool_cli}"
BASE="{{.BaseURL}}"
dir="$(dirname "$DEST")"

case "$(uname -s)" in
  Linux)  OS=linux ;;
  Darwin) OS=darwin ;;
  *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64)  ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac

URL="${BASE}/tool_cli?os=${OS}&arch=${ARCH}"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

echo "downloading $URL ..."
if ! curl -fSL -o "$tmp" "$URL"; then
  echo "download failed; tool_cli binary for ${OS}-${ARCH} may not be bundled" >&2
  exit 1
fi

echo "installing tool_cli to $DEST ..."
if [ -w "$dir" ]; then
  install -m 755 "$tmp" "$DEST"
elif command -v sudo >/dev/null 2>&1; then
  echo "(need sudo to write $dir — override with DEST=...)"
  sudo install -m 755 "$tmp" "$DEST"
else
  echo "cannot write $DEST and sudo not available" >&2
  echo "override: DEST=\$HOME/.local/bin/tool_cli  curl ... | sh" >&2
  exit 1
fi

echo "configuring server URL: ${BASE}"
"$DEST" set-url "${BASE}" >/dev/null

echo "done. tool_cli installed at $DEST"
echo "try: tool_cli help"
