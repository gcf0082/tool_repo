#!/usr/bin/env bash
# tool_cli — thin client wrapper around curl for a tool_repo server.
# Config: ~/.tool_cli/config.json  (key: "url")
# Override for a single call: TOOL_CLI_URL=... tool_cli ...
set -euo pipefail

CONFIG_DIR="${HOME}/.tool_cli"
CONFIG_FILE="${CONFIG_DIR}/config.json"

read_url() {
  if [[ -n "${TOOL_CLI_URL:-}" ]]; then
    printf '%s' "$TOOL_CLI_URL"
    return
  fi
  [[ -f "$CONFIG_FILE" ]] || return 0
  python3 - "$CONFIG_FILE" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        print(json.load(f).get("url", ""), end="")
except Exception:
    pass
PY
}

write_url() {
  mkdir -p "$CONFIG_DIR"
  python3 - "$CONFIG_FILE" "$1" <<'PY'
import json, sys
path, url = sys.argv[1], sys.argv[2]
with open(path, "w") as f:
    json.dump({"url": url}, f, indent=2)
PY
  echo "saved url=$1 to $CONFIG_FILE"
}

require_url() {
  local u
  u="$(read_url)"
  if [[ -z "$u" ]]; then
    echo "no server URL configured. run: tool_cli set-url <url>" >&2
    exit 1
  fi
  printf '%s' "$u"
}

detect_os() {
  case "$(uname -s)" in
    Linux)  echo linux ;;
    Darwin) echo darwin ;;
    *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
  esac
}
detect_arch() {
  case "$(uname -m)" in
    x86_64|amd64)  echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
  esac
}

usage() {
  cat <<'EOF'
tool_cli — client wrapper for tool_repo

Commands:
  set-url <url>                     Save server URL to ~/.tool_cli/config.json
  config                            Show current config
  url                               Print the configured URL
  ping                              Check connectivity to the configured server
  get <name> [options]              Download a package
    options:
      --version, -v <v>             Exact version (default: latest)
      --os <os>                     Override os (default: detected via uname)
      --arch <arch>                 Override arch (default: detected via uname)
      --dir, -d <path>              Target directory (default: current dir)
  install <name> [options]          Download + install (pipe|sh)
    options:
      --dir, -d <path>              Install directory (default: current dir)
  run remote://<path> [args...]     Execute a remote shell script via pipe
                                    (args are passed to the script's $@)
  push <local> remote://<path>      Upload a local file to scripts/<path>
  help                              Show this message

Environment:
  TOOL_CLI_URL=<url>                Override the configured URL for one call
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help)
    usage
    ;;
  set-url)
    [[ $# -eq 1 ]] || { echo "usage: tool_cli set-url <url>" >&2; exit 2; }
    write_url "$1"
    ;;
  config)
    if [[ -f "$CONFIG_FILE" ]]; then
      cat "$CONFIG_FILE"
    else
      echo "(no config at $CONFIG_FILE)"
    fi
    ;;
  url)
    u="$(read_url)"
    [[ -n "$u" ]] && echo "$u" || { echo "(unset)"; exit 1; }
    ;;
  ping)
    base="$(require_url)"
    # HEAD on /, but fall back to GET if HEAD not supported
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 "${base}/")" || code=000
    body="$(curl -sS --max-time 5 "${base}/" 2>/dev/null || true)"
    if [[ "$code" == "200" && "$body" == *"tool_repo"* ]]; then
      echo "OK  ${base}  (HTTP ${code})"
    else
      echo "FAIL  ${base}  (HTTP ${code})" >&2
      [[ -n "$body" ]] && echo "body: ${body:0:200}" >&2
      exit 1
    fi
    ;;
  get)
    [[ $# -ge 1 ]] || { echo "usage: tool_cli get <name> [--version V] [--os X --arch Y] [--dir DIR]" >&2; exit 2; }
    name="$1"; shift
    version=""
    os="$(detect_os)"
    arch="$(detect_arch)"
    dir=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --version|-v) version="$2"; shift 2 ;;
        --os)         os="$2"; shift 2 ;;
        --arch)       arch="$2"; shift 2 ;;
        --dir|-d)     dir="$2"; shift 2 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    base="$(require_url)"
    url="${base}/get_tool?name=${name}&os=${os}&arch=${arch}"
    [[ -n "$version" ]] && url="${url}&version=${version}"
    echo "GET $url" >&2
    if [[ -n "$dir" ]]; then
      mkdir -p "$dir"
      (cd "$dir" && curl -fSL -OJ "$url")
    else
      curl -fSL -OJ "$url"
    fi
    ;;
  run)
    [[ $# -ge 1 ]] || { echo "usage: tool_cli run remote://<path> [args...]" >&2; exit 2; }
    target="$1"; shift
    case "$target" in
      remote://*) path="${target#remote://}" ;;
      *) echo "tool_cli run: target must start with remote:// (got: $target)" >&2; exit 2 ;;
    esac
    case "$path" in
      ""|/*|*..*) echo "bad path: $path" >&2; exit 2 ;;
    esac
    base="$(require_url)"
    # pipefail is already set at the top of this script so curl 4xx/5xx
    # causes the whole pipeline to exit non-zero. "--" terminates sh's
    # option parsing so script args starting with '-' are safe.
    curl -fsSL "${base}/get_script?path=${path}" | sh -s -- "$@"
    ;;
  push)
    [[ $# -eq 2 ]] || { echo "usage: tool_cli push <local> remote://<path>" >&2; exit 2; }
    local="$1"; target="$2"
    [[ -f "$local" ]] || { echo "not a file: $local" >&2; exit 2; }
    case "$target" in
      remote://*) path="${target#remote://}" ;;
      *) echo "tool_cli push: target must start with remote:// (got: $target)" >&2; exit 2 ;;
    esac
    case "$path" in
      ""|/*|*..*) echo "bad path: $path" >&2; exit 2 ;;
    esac
    base="$(require_url)"
    curl -fsSL -T "$local" "${base}/put_script?path=${path}"
    ;;
  install)
    [[ $# -ge 1 ]] || { echo "usage: tool_cli install <name> [--dir DIR]" >&2; exit 2; }
    name=""; dir=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dir|-d) dir="$2"; shift 2 ;;
        -*) echo "unknown arg: $1" >&2; exit 2 ;;
        *)
          [[ -z "$name" ]] || { echo "unexpected positional: $1" >&2; exit 2; }
          name="$1"; shift
          ;;
      esac
    done
    [[ -n "$name" ]] || { echo "usage: tool_cli install <name> [--dir DIR]" >&2; exit 2; }
    base="$(require_url)"
    if [[ -n "$dir" ]]; then
      mkdir -p "$dir"
      (cd "$dir" && curl -fsSL "${base}/install_tool?name=${name}" | sh)
    else
      curl -fsSL "${base}/install_tool?name=${name}" | sh
    fi
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
